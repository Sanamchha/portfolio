---
import profile from '../data/profile.json';
---

<section id="hero" class="relative flex min-h-screen items-center pt-16">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-accent/5 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-blue-500/5 blur-3xl"></div>
  </div>

  <div class="section-container relative z-10 py-20">
    <div class="max-w-3xl animate-on-scroll">
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-accent">
        {profile.subtitle}
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        {profile.name}
      </h1>
      <p class="mt-2 text-xl text-gray-400">{profile.title}</p>
      <p class="mt-6 text-lg leading-relaxed text-gray-300">
        {profile.tagline}
      </p>
      <p class="mt-3 flex items-center gap-2 text-sm text-gray-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {profile.location}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="btn-primary">Contact Me</a>
        <a href={profile.cvPath} download class="btn-secondary">
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          LinkedIn
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>
