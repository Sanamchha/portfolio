---
import education from '../data/education.json';
---

<section id="education" class="py-20">
  <div class="section-container">
    <div class="animate-on-scroll">
      <h2 class="section-heading">Education & Training</h2>
      <p class="section-subheading">Academic foundation and continuous learning</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Education -->
      <div class="card animate-on-scroll">
        <h3 class="mb-4 text-lg font-semibold text-accent">Education</h3>
        <div>
          <p class="font-medium text-white">{education.degree}</p>
          <p class="text-gray-400">{education.institution}</p>
          <p class="mt-1 text-sm text-gray-500">{education.period}</p>
        </div>
      </div>

      <!-- Training -->
      <div class="card animate-on-scroll">
        <details class="group">
          <summary class="cursor-pointer text-lg font-semibold text-accent marker:content-none">
            <span class="flex items-center justify-between">
              Training & Certifications
              <svg
                class="h-5 w-5 transition-transform group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <ul class="mt-4 space-y-3" role="list">
            {
              education.training.map((item) => (
                <li class="flex items-start justify-between gap-4 text-sm">
                  <div>
                    <p class="text-gray-200">{item.name}</p>
                    <p class="text-gray-500">{item.provider}</p>
                  </div>
                  <span class="flex-shrink-0 text-gray-500">{item.year}</span>
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </div>
  </div>
</section>
