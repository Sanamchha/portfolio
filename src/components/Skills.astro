---
import skills from '../data/skills.json';
---

<section id="skills" class="py-20 bg-navy-900/30">
  <div class="section-container">
    <div class="animate-on-scroll">
      <h2 class="section-heading">Core Skills</h2>
      <p class="section-subheading">Technical expertise across automation, testing, and leadership</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <div class="card animate-on-scroll">
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-accent">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="skill-chip">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
