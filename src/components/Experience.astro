---
import experience from '../data/experience.json';
---

<section id="experience" class="py-20">
  <div class="section-container">
    <div class="animate-on-scroll">
      <h2 class="section-heading">Professional Experience</h2>
      <p class="section-subheading">4+ years in healthcare analytics QA automation</p>
    </div>

    <div class="relative mt-12">
      <!-- Timeline line -->
      <div class="absolute left-4 top-0 hidden h-full w-0.5 bg-navy-700 md:left-8 md:block" aria-hidden="true"></div>

      <div class="space-y-8">
        {
          experience.map((job, index) => (
            <article class="animate-on-scroll relative md:pl-20">
              <!-- Timeline dot -->
              <div
                class="absolute left-2.5 top-6 hidden h-3 w-3 rounded-full border-2 border-accent bg-navy-950 md:left-6.5 md:block"
                aria-hidden="true"
              />

              <div class="card">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <h3 class="text-lg font-semibold text-white">{job.role}</h3>
                    <p class="text-accent">
                      {job.company}
                      {job.industry && <span class="text-gray-500"> — {job.industry}</span>}
                    </p>
                    {job.location && <p class="text-sm text-gray-500">{job.location}</p>}
                  </div>
                  <div class="text-right">
                    <time class="text-sm font-medium text-gray-400">{job.period}</time>
                    {job.note && <p class="text-xs text-accent">{job.note}</p>}
                  </div>
                </div>

                <ul class="mt-4 space-y-2" role="list">
                  {job.highlights.map((item) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-gray-300">
                      <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
